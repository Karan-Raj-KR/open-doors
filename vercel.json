{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    {
      "source": "/((?!assets/|favicon.svg|images/|fonts/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": { "api/index.js": { "maxDuration": 30 } }
}
